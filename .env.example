# Servidor
PORT=3020

# Base principal del chatbot (requerida)
DB_HOST=servidor-sql
DB_PORT=1433
DB_NAME=base_chatbot
DB_USER=usuario
DB_PASSWORD=contrasena
DB_SCHEMA=dbo
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
DB_LOGGING=false

# Base operativa / DW (opcional si usa el mismo servidor, usuario y base
# que DB_*; recomendable definirla cuando DW_ISTMA esta separado)
PROD_DB_HOST=servidor-sql
PROD_DB_PORT=1433
PROD_DB_NAME=DW_ISTMA
PROD_DB_USER=usuario
PROD_DB_PASSWORD=contrasena
PROD_DB_SCHEMA=dbo
PROD_DB_ENCRYPT=false
PROD_DB_TRUST_SERVER_CERTIFICATE=true

# Tambien se aceptan los nombres legacy DB_HOST2, DB_PORT2, DB_NAME2,
# DB_USER2 y DB_PASSWORD2 para esta segunda conexion.

# Autenticacion (requerida). Use un valor largo y aleatorio.
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
JWT_EXPIRATION=8h

# OpenAI (requerida para iniciar y para el chat)
OPENAI_API_KEY=sk-reemplazar
OPENAI_INTENT_MODEL=gpt-4.1-mini
OPENAI_CHAT_MODEL=gpt-4.1-mini

# Acceso al endpoint GET /visits/clients: ID_USUARIO del JWT -> rutas permitidas.
# Usar asignaciones autorizadas. No es el usuario SQL ni un dato enviado por PACO.
# Vacío deniega todas las rutas. Ejemplo ficticio: {"12":["S08","S09"]}
VISITS_ROUTE_ACCESS={}
