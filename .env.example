# ENTORNO ACADEMICO LOCAL - datos ficticios.
PORT=3021

# La instancia SQLEXPRESS debe tener TCP/IP activo y puerto fijo 14330.
DB_HOST=127.0.0.1
DB_PORT=14330
DB_NAME=CHATBOT
DB_USER=chatbot_demo
# Credencial de demostración creada por database/local/03_crear_usuario_SQL_local.sql.
DB_PASSWORD=DemoSqlLocal2026!
DB_SCHEMA=dbo
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
DB_LOGGING=false

PROD_DB_HOST=127.0.0.1
PROD_DB_PORT=14330
PROD_DB_NAME=DW_ISTMA
PROD_DB_USER=chatbot_demo
PROD_DB_PASSWORD=DemoSqlLocal2026!
PROD_DB_SCHEMA=dbo
PROD_DB_ENCRYPT=false
PROD_DB_TRUST_SERVER_CERTIFICATE=true

# Genera un valor aleatorio propio antes de iniciar. No uses el secreto empresarial.
JWT_SECRET=reemplazar-con-un-secreto-local-aleatorio
JWT_EXPIRATION=8h

# Valor ficticio para inicializar el SDK. NO habilita consultas de IA.
# Login y GET /visits/clients no llaman a OpenAI.
OPENAI_API_KEY=local-demo-no-openai-requests
OPENAI_INTENT_MODEL=gpt-4.1-mini
OPENAI_CHAT_MODEL=gpt-4.1-mini

# Usuario de demostración admin.local, ID 1; no representa permisos de producción.
VISITS_ROUTE_ACCESS='{"1":["S08","S09"]}'

# academic consulta academico.Visitas (semilla 2026-11-05); es el valor por defecto.
# legacy consulta paco.APP_RV y conserva sus fechas/datos originales.
# Una configuración inválida produce 503, sin cambiar silenciosamente de fuente.
VISITS_DATA_SOURCE=academic

# Recuperación: configurar de forma privada; sin valores, responde 503 y no simula envíos.
FRONTEND_URL=http://localhost:4200
PASSWORD_RESET_SECRET=
BREVO_API_KEY=
RECOVERY_FROM_EMAIL=
